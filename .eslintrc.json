{
  "root": true,
  "env": {
    "es2021": true,
    "node": true
  },
  "extends": ["eslint:recommended", "prettier", "plugin:prettier/recommended"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },

  "rules": {
    "no-unused-vars": "warn",
    "prettier/prettier": [
      "error",
      {
        "endOfLine": "auto"
      },
      {
        "usePrettierrc": true
      },
      {
        "tabWidth": 2,
        "semi": false,
        "singleQuote": true,
        "trailingComma": "none",
        "printWidth": 120,
        "arrowParens": "always"
      }
    ],
    "import/extensions": [
      "error",
      "always",
      {
        "js": "never"
      }
    ],
    "no-console": "error"
  },
  "plugins": ["prettier"],
  "ignorePatterns": ["node_modules/", "dist/"]
}
