{
  "root": true,
  "parserOptions": {
    "ecmaVersion": 2018,
    "sourceType": "module"
  },
  "extends": ["eslint:recommended", "prettier", "plugin:prettier/recommended"],
  "env": {
    "es2021": true,
    "node": true
  },
  "rules": {
    "prettier/prettier": "error",
    "import/extensions": [
      "error",
      "always",
      {
        "js": "never"
      }
    ],
    "no-console": "error"
  }
}
