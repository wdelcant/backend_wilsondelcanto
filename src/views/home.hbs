<section>
  <h1>Lista de productos</h1>
  <div>
    {{#each products}}
      <div class='product-card'>
        <h2>{{this.title}}</h2>
        <img
          src='{{this.thumbnail}}'
          alt='{{this.title}}'
          class='product-image'
        />
        <p>{{this.description}}</p>
        <p>Precio: {{this.price}}</p>
      </div>
    {{/each}}
  </div>
</section>